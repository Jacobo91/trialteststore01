{% comment %}
  Platter technical challenge section.
  Static product-card layout using Unsplash placeholder imagery.
{% endcomment %}

<style>
  #platter-tc-{{ section.id }} {
    --platter-ink: #1f1f1f;
    --platter-muted: #66615f;
    --platter-border: #e9e2dd;
    --platter-surface: #f8f3ef;
    --platter-accent: #b86246;
    color: var(--platter-ink);
    background: {{ section.settings.background_color }};
  }

  #platter-tc-{{ section.id }} .platter-tc__shell {
    max-width: 1440px;
    margin: 0 auto;
    padding: 48px 16px 56px;
  }

  #platter-tc-{{ section.id }} .platter-tc__eyebrow {
    margin: 0 0 10px;
    font-size: 12px;
    line-height: 1.2;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--platter-accent);
  }

  #platter-tc-{{ section.id }} .platter-tc__heading-row {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 28px;
  }

  #platter-tc-{{ section.id }} .platter-tc__title {
    max-width: 760px;
    margin: 0;
    font-size: clamp(34px, 6vw, 80px);
    line-height: 0.92;
    letter-spacing: -0.05em;
    text-transform: uppercase;
  }

  #platter-tc-{{ section.id }} .platter-tc__intro {
    max-width: 290px;
    margin: 0;
    color: var(--platter-muted);
    font-size: 14px;
    line-height: 1.55;
  }

  #platter-tc-{{ section.id }} .platter-tc__scroller {
    overflow-x: auto;
    overflow-y: hidden;
    padding-bottom: 20px;
    scrollbar-color: var(--platter-ink) #ddd6d7;
    scrollbar-width: thin;
  }

  #platter-tc-{{ section.id }} .platter-tc__scroller::-webkit-scrollbar {
    height: 4px;
  }

  #platter-tc-{{ section.id }} .platter-tc__scroller:hover::-webkit-scrollbar,
  #platter-tc-{{ section.id }} .platter-tc__scroller.is-touching::-webkit-scrollbar {
    height: 6px;
  }

  #platter-tc-{{ section.id }} .platter-tc__scroller::-webkit-scrollbar-thumb {
    background: var(--platter-ink);
    border-radius: 999px;
  }

  #platter-tc-{{ section.id }} .platter-tc__scroller::-webkit-scrollbar-track {
    background: #ddd6d7;
    border-radius: 999px;
  }

  #platter-tc-{{ section.id }} .platter-tc__grid {
    display: grid;
    grid-template-columns: repeat(10, minmax(250px, 1fr));
    gap: 18px;
    min-width: 2680px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  #platter-tc-{{ section.id }} .platter-tc__card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 100%;
    overflow: hidden;
    border: 1px solid var(--platter-border);
    border-radius: 24px;
    background: #fff;
  }

  #platter-tc-{{ section.id }} .platter-tc__media {
    position: relative;
    display: block;
    aspect-ratio: 1 / 1.14;
    overflow: hidden;
    background: var(--platter-surface);
  }

  #platter-tc-{{ section.id }} .platter-tc__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 260ms ease, transform 500ms ease;
  }

  #platter-tc-{{ section.id }} .platter-tc__image--secondary {
    opacity: 0;
    transform: scale(1.04);
  }

  #platter-tc-{{ section.id }} .platter-tc__card:hover .platter-tc__image--primary,
  #platter-tc-{{ section.id }} .platter-tc__card:focus-within .platter-tc__image--primary {
    opacity: 0;
    transform: scale(1.04);
  }

  #platter-tc-{{ section.id }} .platter-tc__card:hover .platter-tc__image--secondary,
  #platter-tc-{{ section.id }} .platter-tc__card:focus-within .platter-tc__image--secondary {
    opacity: 1;
    transform: scale(1);
  }

  #platter-tc-{{ section.id }} .platter-tc__badge {
    position: absolute;
    top: 14px;
    left: 14px;
    z-index: 2;
    padding: 7px 11px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.9);
    color: var(--platter-ink);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    backdrop-filter: blur(8px);
  }

  #platter-tc-{{ section.id }} .platter-tc__content {
    display: grid;
    gap: 10px;
    padding: 18px;
  }

  #platter-tc-{{ section.id }} .platter-tc__product-title {
    margin: 0;
    font-size: 18px;
    line-height: 1.05;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }

  #platter-tc-{{ section.id }} .platter-tc__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    color: var(--platter-muted);
    font-size: 13px;
    line-height: 1.3;
  }

  #platter-tc-{{ section.id }} .platter-tc__price {
    color: var(--platter-ink);
    font-weight: 800;
  }

  #platter-tc-{{ section.id }} .platter-tc__swatches {
    display: flex;
    gap: 6px;
  }

  #platter-tc-{{ section.id }} .platter-tc__swatch {
    width: 14px;
    height: 14px;
    border: 1px solid rgba(31, 31, 31, 0.16);
    border-radius: 999px;
  }

  #platter-tc-{{ section.id }} .platter-tc__button-wrap {
    display: none;
  }

  @media screen and (max-width: 749px) {
    #platter-tc-{{ section.id }} .platter-tc__shell {
      padding: 36px 16px 44px;
    }

    #platter-tc-{{ section.id }} .platter-tc__heading-row {
      display: block;
      margin-bottom: 22px;
    }

    #platter-tc-{{ section.id }} .platter-tc__intro {
      max-width: none;
      margin-top: 12px;
      font-size: 13px;
    }

    #platter-tc-{{ section.id }} .platter-tc__scroller {
      overflow: visible;
      padding-bottom: 0;
    }

    #platter-tc-{{ section.id }} .platter-tc__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      min-width: 0;
      gap: 12px;
    }

    #platter-tc-{{ section.id }} .platter-tc__grid-wrap {
      overflow: hidden;
      max-height: var(--platter-collapsed-height, 0px);
      transition: max-height 520ms cubic-bezier(0.22, 1, 0.36, 1);
    }

    #platter-tc-{{ section.id }} .platter-tc__grid-wrap.is-expanded {
      max-height: var(--platter-expanded-height, 2400px);
    }

    #platter-tc-{{ section.id }} .platter-tc__product.is-mobile-extra {
      display: none;
    }

    #platter-tc-{{ section.id }} .platter-tc__grid-wrap.is-expanded .platter-tc__product.is-mobile-extra {
      display: block;
    }

    #platter-tc-{{ section.id }} .platter-tc__card {
      border-radius: 18px;
    }

    #platter-tc-{{ section.id }} .platter-tc__badge {
      top: 9px;
      left: 9px;
      padding: 5px 8px;
      font-size: 9px;
    }

    #platter-tc-{{ section.id }} .platter-tc__content {
      padding: 12px;
      gap: 8px;
    }

    #platter-tc-{{ section.id }} .platter-tc__product-title {
      font-size: 14px;
    }

    #platter-tc-{{ section.id }} .platter-tc__meta {
      display: grid;
      gap: 5px;
      font-size: 12px;
    }

    #platter-tc-{{ section.id }} .platter-tc__button-wrap {
      display: block;
      margin-top: 18px;
      text-align: center;
    }

    #platter-tc-{{ section.id }} .platter-tc__show-more {
      width: min(100%, 327px);
      min-height: 52px;
      border: 0;
      border-radius: 999px;
      background: var(--platter-ink);
      color: #fff;
      font: inherit;
      font-size: 15px;
      font-weight: 800;
      letter-spacing: 0.04em;
      cursor: pointer;
      transition: transform 180ms ease, background 180ms ease;
    }

    #platter-tc-{{ section.id }} .platter-tc__show-more:hover,
    #platter-tc-{{ section.id }} .platter-tc__show-more:focus-visible {
      background: #000;
      transform: translateY(-1px);
    }
  }
</style>

<section id="platter-tc-{{ section.id }}" class="platter-tc color-{{ section.settings.color_scheme }} md:pl-[64px] lg:pl-[128px]">
  <div class="platter-tc__shell px-[16px] py-[48px] md:py-[72px]">
    <p class="platter-tc__eyebrow">{{ section.settings.eyebrow }}</p>

    <div class="platter-tc__heading-row">
      <h2 class="platter-tc__title text-[34px] md:text-[80px] font-bold uppercase">
        {{ section.settings.heading }}
      </h2>
      <p class="platter-tc__intro text-[14px]">
        {{ section.settings.subheading }}
      </p>
    </div>

    <product-card-reveal class="platter-tc__component" data-section-id="{{ section.id }}">
      <div class="platter-tc__scroller" data-platter-scroller>
        <div class="platter-tc__grid-wrap" data-platter-grid-wrap>
          <ul class="platter-tc__grid flex md:flex-nowrap" role="list" data-platter-grid>
            {% assign titles = 'Sunday Ribbed Tank|Market Linen Shirt|Coastal Utility Pant|Studio Poplin Dress|Gallery Cotton Short|Terrace Knit Polo|Archive Denim Jacket|Soft Lounge Trouser|Washed Canvas Tote|Evening Slip Skirt' | split: '|' %}
            {% assign categories = 'Best Seller|New Color|Low Stock|Editor Pick|Organic Cotton|Vacation Ready|Layering Hero|Soft Touch|Carry All|Limited Run' | split: '|' %}
            {% assign prices = '$48|$86|$118|$132|$64|$78|$148|$96|$58|$110' | split: '|' %}
            {% assign image_a = 'https://images.unsplash.com/photo-1529139574466-a303027c1d8b?auto=format&fit=crop&w=900&q=80|https://images.unsplash.com/photo-1485968579580-b6d095142e6e?auto=format&fit=crop&w=900&q=80|https://images.unsplash.com/photo-1506629905607-d9e297d5f5f4?auto=format&fit=crop&w=900&q=80|https://images.unsplash.com/photo-1496747611176-843222e1e57c?auto=format&fit=crop&w=900&q=80|https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?auto=format&fit=crop&w=900&q=80|https://images.unsplash.com/photo-1520975954732-35dd22299614?auto=format&fit=crop&w=900&q=80|https://images.unsplash.com/photo-1503342217505-b0a15ec3261c?auto=format&fit=crop&w=900&q=80|https://images.unsplash.com/photo-1483985988355-763728e1935b?auto=format&fit=crop&w=900&q=80|https://images.unsplash.com/photo-1554342872-034a06541bad?auto=format&fit=crop&w=900&q=80|https://images.unsplash.com/photo-1515372039744-b8f02a3ae446?auto=format&fit=crop&w=900&q=80' | split: '|' %}
            {% assign image_b = 'https://images.unsplash.com/photo-1509631179647-0177331693ae?auto=format&fit=crop&w=900&q=80|https://images.unsplash.com/photo-1512436991641-6745cdb1723f?auto=format&fit=crop&w=900&q=80|https://images.unsplash.com/photo-1520975916090-3105956dac38?auto=format&fit=crop&w=900&q=80|https://images.unsplash.com/photo-1524504388940-b1c1722653e1?auto=format&fit=crop&w=900&q=80|https://images.unsplash.com/photo-1495385794356-15371f348c31?auto=format&fit=crop&w=900&q=80|https://images.unsplash.com/photo-1487222477894-8943e31ef7b2?auto=format&fit=crop&w=900&q=80|https://images.unsplash.com/photo-1520975682031-a3b9bb42d4ef?auto=format&fit=crop&w=900&q=80|https://images.unsplash.com/photo-1529139574466-a303027c1d8b?auto=format&fit=crop&w=900&q=80|https://images.unsplash.com/photo-1584917865442-de89df76afd3?auto=format&fit=crop&w=900&q=80|https://images.unsplash.com/photo-1495385794356-15371f348c31?auto=format&fit=crop&w=900&q=80' | split: '|' %}

            {% for title in titles %}
              <li class="platter-tc__product{% if forloop.index > 4 %} is-mobile-extra{% endif %}" data-platter-product>
                <article class="platter-tc__card h-full">
                  <a class="platter-tc__media" href="#" aria-label="View {{ title | escape }}">
                    <span class="platter-tc__badge">{{ categories[forloop.index0] }}</span>
                    <img
                      class="platter-tc__image platter-tc__image--primary"
                      src="{{ image_a[forloop.index0] }}"
                      alt="{{ title | escape }} primary product view"
                      loading="lazy"
                      width="900"
                      height="1026"
                    >
                    <img
                      class="platter-tc__image platter-tc__image--secondary"
                      src="{{ image_b[forloop.index0] }}"
                      alt="{{ title | escape }} alternate product view"
                      loading="lazy"
                      width="900"
                      height="1026"
                    >
                  </a>

                  <div class="platter-tc__content">
                    <h3 class="platter-tc__product-title">{{ title }}</h3>
                    <div class="platter-tc__meta">
                      <span>★★★★★ 1,234 Reviews</span>
                      <span class="platter-tc__price">{{ prices[forloop.index0] }}</span>
                    </div>
                    <div class="platter-tc__swatches" aria-label="Available colors">
                      <span class="platter-tc__swatch" style="background: #1f1f1f;"></span>
                      <span class="platter-tc__swatch" style="background: #d8c5b4;"></span>
                      <span class="platter-tc__swatch" style="background: #f4eee8;"></span>
                    </div>
                  </div>
                </article>
              </li>
            {% endfor %}
          </ul>
        </div>
      </div>

      <div class="platter-tc__button-wrap">
        <button class="platter-tc__show-more" type="button" data-platter-toggle aria-expanded="false">
          {{ section.settings.show_more_label }}
        </button>
      </div>
    </product-card-reveal>
  </div>
</section>

<script>
  class ProductCardReveal extends HTMLElement {
    connectedCallback() {
      this.gridWrap = this.querySelector('[data-platter-grid-wrap]');
      this.grid = this.querySelector('[data-platter-grid]');
      this.toggle = this.querySelector('[data-platter-toggle]');
      this.scroller = this.querySelector('[data-platter-scroller]');
      this.mobileQuery = window.matchMedia('(max-width: 749px)');

      this.syncHeights = this.syncHeights.bind(this);
      this.onToggle = this.onToggle.bind(this);
      this.markTouching = this.markTouching.bind(this);

      this.toggle?.addEventListener('click', this.onToggle);
      this.scroller?.addEventListener('touchstart', this.markTouching, { passive: true });
      window.addEventListener('resize', this.syncHeights);
      this.mobileQuery.addEventListener?.('change', this.syncHeights);

      requestAnimationFrame(this.syncHeights);
    }

    disconnectedCallback() {
      this.toggle?.removeEventListener('click', this.onToggle);
      this.scroller?.removeEventListener('touchstart', this.markTouching);
      window.removeEventListener('resize', this.syncHeights);
      this.mobileQuery.removeEventListener?.('change', this.syncHeights);
    }

    onToggle() {
      if (!this.gridWrap || !this.toggle) return;

      const isExpanded = this.gridWrap.classList.toggle('is-expanded');
      this.toggle.setAttribute('aria-expanded', String(isExpanded));
      this.toggle.textContent = isExpanded ? '{{ section.settings.show_less_label | escape }}' : '{{ section.settings.show_more_label | escape }}';
      this.syncHeights();
    }

    syncHeights() {
      if (!this.gridWrap || !this.grid) return;

      if (!this.mobileQuery.matches) {
        this.gridWrap.style.removeProperty('--platter-collapsed-height');
        this.gridWrap.style.removeProperty('--platter-expanded-height');
        return;
      }

      const items = Array.from(this.grid.querySelectorAll('[data-platter-product]'));
      const firstVisibleRows = items.slice(0, 4);
      const collapsedHeight = firstVisibleRows.reduce((height, item) => Math.max(height, item.offsetTop + item.offsetHeight), 0);

      this.gridWrap.style.setProperty('--platter-collapsed-height', `${collapsedHeight}px`);
      this.gridWrap.style.setProperty('--platter-expanded-height', `${this.grid.scrollHeight}px`);
    }

    markTouching() {
      if (!this.scroller) return;
      this.scroller.classList.add('is-touching');
      window.setTimeout(() => this.scroller.classList.remove('is-touching'), 900);
    }
  }

  if (!customElements.get('product-card-reveal')) {
    customElements.define('product-card-reveal', ProductCardReveal);
  }
</script>

{% schema %}
{
  "name": "Platter TC",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The edit"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop the latest essentials"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Ten elevated staples with responsive cards, smooth mobile reveal, and alternate hover imagery."
    },
    {
      "type": "text",
      "id": "show_more_label",
      "label": "Show more label",
      "default": "Show More"
    },
    {
      "type": "text",
      "id": "show_less_label",
      "label": "Show less label",
      "default": "Show Less"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "background-1"
    }
  ],
  "presets": [
    {
      "name": "Platter TC"
    }
  ]
}
{% endschema %}
